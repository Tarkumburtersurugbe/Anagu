# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign session tokens (change in production).
JWT_SECRET="replace-with-strong-32-char-secret"

# DATABASE_PATH: Local SQLite persistence file for development.
DATABASE_PATH="./anagu.db"

# POSTGRES_URL: Optional PostgreSQL + PostGIS connection string for production.
POSTGRES_URL="postgresql://anagu:anagu_password@localhost:5432/anagu_gis"

# BESU_RPC_URL: Optional Hyperledger Besu JSON-RPC endpoint.
BESU_RPC_URL="http://localhost:8545"

# MQTT_BROKER_URL: Optional external EMQX / Mosquitto MQTT broker URL.
MQTT_BROKER_URL="mqtt://localhost:1883"

# SUPABASE: Server-side Supabase project & JWKS verification configuration.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
